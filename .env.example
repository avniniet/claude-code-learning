# Copy to .env (gitignored) and fill in.
# Get a token at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Optional reserved/static ngrok domain, e.g. avnish.ngrok.app
NGROK_DOMAIN=

# Host port for the nginx container
WEB_PORT=8080

# Frontend data source: static | api
VITE_DATA_SOURCE=static
VITE_API_BASE_URL=
