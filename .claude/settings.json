{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/review-changed-file.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": "docker-compose.yml|package.json|vite.config.ts|index.html|eslint.config.js|tsconfig.json",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/review-changed-file.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
